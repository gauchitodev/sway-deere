# Notificaciones con estilo G5: como las ventanas de la S770
# (fondo oscuro, marco claro y grueso con esquinas redondeadas)
font=Open Sans, Cantarell 11
background-color=#2c2a24
text-color=#ffffff
border-color=#eef0ea
border-size=4
border-radius=10
padding=14
margin=10
width=380
progress-color=over #367c2b
default-timeout=8000

[urgency=low]
border-color=#8d8474

# Las urgentes con el marco amarillo, como lo seleccionado en la G5
[urgency=high]
border-color=#ffde00
default-timeout=0
