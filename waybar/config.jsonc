// Barra G5: parte de la config de Carlos (~/.config/waybar/config)
// y solo cambia el orden, el alto y algunos formatos.
{
    "include": ["~/.config/waybar/config"],

    "height": 34,

    // Izquierda = barra de título verde (escritorios + ventana activa)
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [],
    // Derecha = bloque de estado verde azulado, como en la G5
    "modules-right": [
        "pulseaudio",
        "network",
        "image#carga-red",
        "memory",
        "cpu",
        "temperature",
        "custom/keyboard-layout",
        "battery",
        "tray",
        "clock#date",
        "clock#time",
        "custom/inicio"
    ],

    "network": {
        "interval": 5,
        "format-wifi": "  {essid} {signalStrength}%",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "⚠  Sin wifi",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nTocá para elegir red",
        "on-click": "~/.config/g5/wifi/abrir.sh"
    },

    // Carga del internet: rampa al lado del wifi, como la carga del motor de la cosechadora
    // El dibujo lo hace carga-red.py en segundo plano (lo arranca lanzar.sh);
    // cuando cambia, avisa con la señal 9 y la barra lee la ruta y la ayuda.
    "image#carga-red": {
        "exec": "cat \"${XDG_RUNTIME_DIR:-/tmp/g5-$(id -u)}/g5-carga-red.txt\" 2>/dev/null",
        "signal": 9,
        // Sin "interval" esta versión de Waybar corre el exec sin parar y se traba:
        // uno largo de respaldo, lo normal es que actualice con la señal.
        "interval": 3600,
        "size": 112,
        "tooltip": true
    },

    // Volumen: con parlante Bluetooth se ve el símbolo en celeste y el nombre
    // del aparato adelante, en vez del símbolo pegado atrás del porcentaje.
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "<span color='#7cc4ff'>\uf294</span> <span color='#9fc9bc'>{desc}</span>   {icon}  {volume}%",
        "format-bluetooth-muted": "<span color='#7cc4ff'>\uf294</span> <span color='#9fc9bc'>{desc}</span>   <span color='#e0453c'>\uf026  Mudo</span>",
        "format-muted": "<span color='#e0453c'>\uf026  Mudo</span>",
        "tooltip-format": "{desc} · {volume}%",
        "on-click": "pavucontrol"
    },

    "clock#time": {
        "interval": 10,
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "sway/window": {
        "format": "{}",
        "max-length": 80
    },

    // Botón verde que abre la pantalla de inicio (igual que Super+G)
    "custom/inicio": {
        "format": "  Inicio ",
        "on-click": "~/.config/g5/home/inicio.sh",
        "tooltip": false
    }
}
