// Barra G5: parte de la config de Carlos (~/.config/waybar/config)
// y solo cambia el orden, el alto y algunos formatos.
{
    "include": ["~/.config/waybar/config"],

    "height": 52,

    // Izquierda = la "Run Page" de la cosechadora: los escritorios 1, 2, 3 son las Run Pages
    "modules-left": [
        "custom/runpage",
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "image#carga-red",
        "network",
        "battery",
        "custom/tapa",
        "tray",
        "clock#date",
        "clock#time",
        "custom/estado",
        "custom/inicio"
    ],

    "custom/runpage": {
        "format": "Run Page",
        "tooltip": false
    },

    // Botón del panel de estado (wifi, volumen, brillo, CPU, memoria, temperaturas...)
    "custom/estado": {
        "format": "  ▾  ",
        "on-click": "~/.config/g5/sombra/abrir.sh",
        "tooltip": true,
        "tooltip-format": "Estado del equipo (Super+Shift+S)"
    },

    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "\uf0e7  {capacity}%",
        "format-plugged": "\uf1e6  {capacity}%",
        "tooltip-format": "{timeTo}",
        "on-click": "~/.config/g5/sombra/abrir.sh"
    },

    "network": {
        "interval": 5,
        "format-wifi": "\uf1eb  {signalStrength}%",
        "format-ethernet": "\uf796  Cable",
        "format-disconnected": "⚠  Sin wifi",
        "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\nTocá para elegir red",
        "on-click": "~/.config/g5/wifi/abrir.sh"
    },

    // Carga del internet: rampa al lado del wifi, como la carga del motor de la cosechadora
    // El dibujo lo hace carga-red.py en segundo plano (lo arranca lanzar.sh);
    // cuando cambia, avisa con la señal 9 y la barra lee la ruta y la ayuda.
    "image#carga-red": {
        "exec": "cat \"${XDG_RUNTIME_DIR:-/tmp/g5-$(id -u)}/g5-carga-red.txt\" 2>/dev/null",
        "signal": 9,
        // Sin "interval" esta versión de Waybar corre el exec sin parar y se traba:
        // uno largo de respaldo, lo normal es que actualice con la señal.
        "interval": 3600,
        "size": 112,
        "tooltip": true
    },

    "clock#time": {
        "interval": 10,
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "sway/window": {
        "format": "{}",
        "max-length": 60
    },

    // Botón verde que abre la pantalla de inicio (igual que Super+G)
    // Modo tapa cerrada: al cerrar la tapa se bloquea y apaga la pantalla, sin suspender.
    // Momentáneo: se apaga tocándolo de nuevo, o solo al reiniciar. Super+Shift+T también.
    "custom/tapa": {
        "exec": "~/.config/g5/tapa/tapa.sh estado",
        "return-type": "json",
        "interval": 60,
        "signal": 10,
        "on-click": "~/.config/g5/tapa/tapa.sh"
    },

    "custom/inicio": {
        "format": "  Inicio ",
        "on-click": "~/.config/g5/home/inicio.sh",
        "tooltip": false
    }
}
